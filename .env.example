# Aurora Concierge — environment variables
# Copy to .env and fill in.

VITE_NUCLIA_API_URL=https://aws-eu-1.rag.progress.cloud/api/v1
VITE_NUCLIA_KB_ID=paste-your-aurora-kb-uuid-here
VITE_NUCLIA_API_KEY=paste-your-service-account-jwt-here

# Region: EU | US
VITE_AURORA_REGION=EU

# BYO-LLM
VITE_BYO_LLM_PROVIDERS=azure-openai,google-vertex,aws-bedrock
VITE_BYO_LLM_DEFAULT=azure-openai

# Multilingual: which languages to expose in the Concierge dropdown.
VITE_LANGUAGES=English,Spanish,French,German,Japanese,Mandarin

# Node-side seed env
NUCLIA_API_URL=https://aws-eu-1.rag.progress.cloud/api/v1
NUCLIA_KB_ID=paste-your-aurora-kb-uuid-here
NUCLIA_API_KEY=paste-your-service-account-jwt-here
